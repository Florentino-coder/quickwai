{
  "name": "quickwai",
  "version": "0.2.4",
  "private": true,
  "description": "QuickWai: quick replies for LINE OA (desktop app + Chrome extension)",
  "main": "desktop/boot.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.quickwai.app",
    "productName": "QuickWai",
    "asar": false,
    "files": [
      "desktop/**",
      "extension/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "QuickWai-Setup-${version}.exe"
    },
    "copyright": "Florentino356"
  },
  "author": "Florentino356"
}
