{
  "manifest_version": 3,
  "name": "QuickWai Note Reader",
  "version": "0.2.5",
  "description": "อ่านชื่อลูกค้าจากโน้ตใน LINE OA แล้วส่งให้โปรแกรม QuickWai บนเครื่องนี้",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.line.biz/*",
    "http://127.0.0.1:38457/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.line.biz/*"
      ],
      "js": [
        "extract-name.js",
        "overlay.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickWai"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
